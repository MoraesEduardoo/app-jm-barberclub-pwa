-- ==============================================================================
-- PARTE 9: RPCs AUXILIARES PARA GESTÃO E CANCELAMENTO NO CHAT
-- ==============================================================================
CREATE OR REPLACE FUNCTION public.chatbot_booked_times(
    p_barber_id uuid,
    p_date date
)
RETURNS TABLE (booked_time text)
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
    RETURN QUERY
    SELECT to_char(appointment_time, 'HH24:MI') as booked_time
    FROM public.appointments
    WHERE barber_id = p_barber_id
      AND appointment_date = p_date
      AND status IN ('confirmed', 'confirmado', 'pending', 'pendente', 'completed', 'concluido', 'concluído', 'bloqueado', 'blocked')
    ORDER BY appointment_time ASC;
END;
$$;


CREATE OR REPLACE FUNCTION public.chatbot_list_appointments(
    p_phone text
)
RETURNS TABLE (
    id uuid,
    barber_id uuid,
    barber_name text,
    service_id uuid,
    service_name text,
    appointment_date date,
    appointment_time time,
    status text,
    notes text
)
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
    v_clean text := regexp_replace(p_phone, '\D', '', 'g');
BEGIN
    RETURN QUERY
    SELECT 
        a.id,
        a.barber_id,
        b.name AS barber_name,
        a.service_id,
        COALESCE(s.name, 'Serviço Personalizado') AS service_name,
        a.appointment_date,
        a.appointment_time,
        a.status,
        a.notes
    FROM public.appointments a
    LEFT JOIN public.barbers b ON b.id = a.barber_id
    LEFT JOIN public.services s ON s.id = a.service_id
    WHERE a.client_phone = v_clean
      AND a.status IN ('confirmed', 'confirmado', 'pending', 'pendente')
      AND a.appointment_date >= (timezone('America/Fortaleza', now()))::date
    ORDER BY a.appointment_date ASC, a.appointment_time ASC;
END;
$$;


CREATE OR REPLACE FUNCTION public.chatbot_cancel_appointments(
    p_ids uuid[],
    p_phone text
)
RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
    v_clean text := regexp_replace(p_phone, '\D', '', 'g');
    v_affected integer;
BEGIN
    UPDATE public.appointments
    SET status = 'cancelado', updated_at = now()
    WHERE id = ANY(p_ids)
      AND client_phone = v_clean
      AND status IN ('confirmed', 'confirmado', 'pending', 'pendente');


    GET DIAGNOSTICS v_affected = ROW_COUNT;


    RETURN jsonb_build_object(
        'success', (v_affected > 0),
        'affected_rows', v_affected
    );
END;
$$;


