# ==============================================================================
# JM BARBERCLUB — CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env / .env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (OBRIGATÓRIO)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# URL da API do projeto (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Anônima / Pública (Project API Keys -> anon / public)
# Necessária para inicialização do cliente Supabase no navegador e queries públicas
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de Serviço Administrativa (Project API Keys -> service_role)
# CRÍTICA: Somente servidor. Usada pelas Server Actions para bypass de RLS,
# gravação direta no banco, upload no Storage e assinatura de sessão dos barbeiros.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. DOMÍNIO E URL DA APLICAÇÃO (OBRIGATÓRIO PARA LINKS E PWA)
# ------------------------------------------------------------------------------
# URL canônica da aplicação em produção ou desenvolvimento
NEXT_PUBLIC_SITE_URL=https://painel.jmbarberclub.app

# URL oficial do Chatbot de Agendamento (WhatsApp / Link de retorno)
NEXT_PUBLIC_CHATBOT_URL=https://chatbot-jmbarberclub.vercel.app/

# ------------------------------------------------------------------------------
# 3. SEGURANÇA E SESSÃO (OPCIONAL / COM FALLBACK AUTOMÁTICO)
# ------------------------------------------------------------------------------
# Segredo para assinatura criptográfica do cookie de sessão (jm_barber_session).
# Se não preenchido, o sistema utiliza com segurança a própria SUPABASE_SERVICE_ROLE_KEY.
SESSION_SECRET=

# Pepper para hash seguro dos códigos de recuperação de acesso dos barbeiros.
# Se não preenchido, utiliza a própria SUPABASE_SERVICE_ROLE_KEY como fallback.
RECOVERY_CODE_PEPPER=

# Domínio interno para geração sintética de e-mail dos barbeiros (padrão)
NEXT_PUBLIC_BARBER_AUTH_DOMAIN=barbers.jmbarberclub.app

# ------------------------------------------------------------------------------
# 4. NOTIFICAÇÕES WEB PUSH (VAPID) — AVISOS NO CELULAR DO BARBEIRO
# Gere um par de chaves executando no terminal: npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
# Chave pública VAPID (exposta ao cliente para solicitar permissão de push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Chave privada VAPID (estritamente confidencial, usada para assinar envios push)
VAPID_PRIVATE_KEY=

# Contato do responsável pelo serviço push (mailto:seu-email@dominio.com)
VAPID_SUBJECT=mailto:moraesedu1313@gmail.com

# Segredo compartilhado para proteger webhooks de push externos (ex: /api/push/appointment-created)
PUSH_WEBHOOK_SECRET=sua_chave_secreta_webhook_aqui

# ------------------------------------------------------------------------------
# 5. MENSAGERIA WHATSAPP & CHATBOT (OPCIONAL)
# Para disparo automático de confirmações/lembretes via gateway (Evolution API, Z-API, Baileys)
# Se não preenchido, o sistema gera links diretos wa.me para abertura manual no WhatsApp.
# ------------------------------------------------------------------------------
# URL do endpoint HTTP do seu webhook/gateway de WhatsApp
WHATSAPP_WEBHOOK_URL=

# Token de autenticação Bearer da API de WhatsApp (se exigido pelo gateway)
WHATSAPP_API_TOKEN=